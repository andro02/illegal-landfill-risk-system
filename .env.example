# Copy this file to .env and fill in the values.

# password of the database user (any long random string)
DB_PASSWORD=change-me

# major version of PostgreSQL the dump was created with (or newer)
PG_MAJOR=17

# "http://localhost" locally; the server's host name in production,
# e.g. 130-61-12-34.sslip.io (Caddy then sets up HTTPS automatically)
SITE_ADDRESS=http://localhost
